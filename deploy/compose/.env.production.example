RECORDLANE_ENVIRONMENT=production
RECORDLANE_DATABASE_URL=postgresql+psycopg://recordlane_runtime@postgres.example/recordlane
RECORDLANE_DEMO_MODE=false
RECORDLANE_PUBLIC_URL=https://mdm.example.com
RECORDLANE_ALLOWED_ORIGINS=["https://mdm.example.com"]
RECORDLANE_OIDC_ISSUER=https://id.example.com/realms/recordlane
RECORDLANE_OIDC_AUDIENCE=recordlane
RECORDLANE_SESSION_SECRET=replace-with-at-least-32-random-characters
RECORDLANE_MASTER_KEY_FILE=/run/secrets/recordlane-master-key

