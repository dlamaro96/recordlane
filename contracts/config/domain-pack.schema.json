{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recordlane.dev/contracts/config/domain-pack-1.0.schema.json",
  "title": "Recordlane domain pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "recordlane.io/v1alpha1"},
    "kind": {"const": "DomainPack"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "version": {"type": "string", "minLength": 1}}
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["entity", "mode", "attributes", "identifierNamespaces"],
      "properties": {
        "entity": {"type": "string", "minLength": 1},
        "mode": {"enum": ["registry", "consolidation", "centralized", "coexistence"]},
        "attributes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "type"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "name": {"type": "string"},
              "type": {"enum": ["string", "integer", "decimal", "boolean", "date", "datetime", "reference"]},
              "required": {"type": "boolean"}, "allowedValues": {"type": "array"}, "allowed_values": {"type": "array"},
              "pattern": {"type": "string", "maxLength": 256},
              "normalizer": {"enum": ["preserve", "uppercase_trim", "unicode_casefold"]}
            }
          }
        },
        "identifierNamespaces": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "identifiers": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["field"], "properties": {
            "field": {"type": "string"}, "namespace": {"type": "string"}, "hard_conflict": {"type": "boolean"}
          }}
        },
        "relationships": {
          "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": {
            "type": {"type": "string"}, "target": {"type": "string"},
            "cardinality": {"enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"]},
            "effectiveDated": {"type": "boolean"}
          }}
        },
        "validation": {
          "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["attribute"], "properties": {
            "attribute": {"type": "string"}, "allowedValues": {"type": "array"}
          }}
        },
        "matching": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "blocking": {"type": "array", "items": {"oneOf": [
              {"type": "string"},
              {"type": "object", "additionalProperties": false, "properties": {
                "fields": {"type": "array", "items": {"type": "string"}},
                "prefix": {"type": "object", "additionalProperties": false, "required": ["field", "length"], "properties": {
                  "field": {"type": "string"}, "length": {"type": "integer", "minimum": 1, "maximum": 64}
                }}
              }}
            ]}},
            "comparisons": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["field", "comparator", "weight"], "properties": {
                "field": {"type": "string"}, "comparator": {"enum": ["exact", "sequence_ratio"]},
                "weight": {"type": "number", "exclusiveMinimum": 0},
                "missing_score": {"type": "number", "minimum": 0, "maximum": 1}
              }}},
            "thresholds": {"type": "object", "additionalProperties": false, "required": ["review", "auto_link"], "properties": {
              "review": {"type": "number", "minimum": 0, "maximum": 1},
              "auto_link": {"type": "number", "minimum": 0, "maximum": 1}
            }},
            "auto_link": {"type": "number", "minimum": 0, "maximum": 1},
            "review": {"type": "number", "minimum": 0, "maximum": 1},
            "hard_conflicts": {"type": "array", "items": {"type": "string"}}
          }
        },
        "survivorship": {"type": "object", "additionalProperties": {"oneOf": [
          {"type": "string"},
          {"type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {
            "strategy": {"type": "string"}, "source_precedence": {"type": "array", "items": {"type": "string"}}
          }}
        ]}}
      }
    }
  }
}
