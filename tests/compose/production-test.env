# Synthetic acceptance-only production settings. Never use this file in a deployment.
RECORDLANE_ENVIRONMENT=production
RECORDLANE_DATABASE_URL=postgresql+psycopg://recordlane_migrator:demo-only-migrator@postgres:5432/recordlane_production_acceptance
RECORDLANE_MIGRATION_DATABASE_URL=postgresql+psycopg://recordlane_migrator:demo-only-migrator@postgres:5432/recordlane_production_acceptance
RECORDLANE_DEMO_MODE=false
RECORDLANE_PUBLIC_URL=http://127.0.0.1:18088
RECORDLANE_ALLOWED_ORIGINS=["http://127.0.0.1:18088"]
RECORDLANE_ALLOWED_HOSTS=["127.0.0.1","localhost","api"]
RECORDLANE_OIDC_ISSUER=http://127.0.0.1:58080/realms/recordlane
RECORDLANE_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/recordlane/.well-known/openid-configuration
RECORDLANE_OIDC_AUTHORIZATION_URL=http://127.0.0.1:58080/realms/recordlane/protocol/openid-connect/auth
RECORDLANE_OIDC_TOKEN_URL=http://keycloak:8080/realms/recordlane/protocol/openid-connect/token
RECORDLANE_OIDC_JWKS_URL=http://keycloak:8080/realms/recordlane/protocol/openid-connect/certs
RECORDLANE_OIDC_END_SESSION_URL=http://127.0.0.1:58080/realms/recordlane/protocol/openid-connect/logout
RECORDLANE_OIDC_AUDIENCE=recordlane-api
RECORDLANE_OIDC_CLIENT_ID=recordlane
RECORDLANE_SESSION_SECRET=synthetic-production-acceptance-session-secret
RECORDLANE_MASTER_KEY_FILE=/run/secrets/recordlane-master-key
RECORDLANE_SCIM_TOKEN_FILE=/run/secrets/recordlane-scim-token
RECORDLANE_METRICS_TOKEN_FILE=/run/secrets/recordlane-metrics-token
RECORDLANE_OUTBOUND_ENABLED=false
RECORDLANE_BIND_ADDRESS=127.0.0.1
RECORDLANE_PORT=18088
