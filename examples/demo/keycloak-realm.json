{
  "realm": "recordlane",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "roles": {"realm": [{"name":"administrator"},{"name":"modeler"},{"name":"integration_operator"},{"name":"steward"},{"name":"approver"},{"name":"auditor"},{"name":"read_only"}]},
  "clients": [{
    "clientId": "recordlane",
    "publicClient": true,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["http://127.0.0.1:8088/*"],
    "webOrigins": ["http://127.0.0.1:8088"],
    "attributes": {"pkce.code.challenge.method": "S256"},
    "protocolMappers": [
      {
        "name": "recordlane workspace",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": {
          "user.attribute": "recordlane_workspace",
          "claim.name": "recordlane_workspace",
          "jsonType.label": "String",
          "id.token.claim": "true",
          "access.token.claim": "true",
          "userinfo.token.claim": "true"
        }
      },
      {
        "name": "recordlane API audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.client.audience": "recordlane-api",
          "id.token.claim": "false",
          "access.token.claim": "true"
        }
      }
    ]
  }, {
    "clientId": "recordlane-api",
    "bearerOnly": true,
    "standardFlowEnabled": false,
    "directAccessGrantsEnabled": false
  }],
  "users": [{
    "username": "demo-steward",
    "enabled": true,
    "email": "demo-steward@recordlane.invalid",
    "firstName": "Demo",
    "lastName": "Steward",
    "emailVerified": true,
    "requiredActions": [],
    "realmRoles": ["administrator", "steward"],
    "attributes": {"recordlane_workspace": ["demo"]},
    "credentials": [{"type":"password","value":"demo-steward-change-me","temporary":false}]
  }]
}
