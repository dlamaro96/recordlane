digraph G { graph [label="Version-bound approval",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; Draft [label="Draft master vN"]; Task [label="Review task\nbinds entity vN + workflow vM"]; Change [label="Concurrent source/policy change?"]; Reject [label="STALE · explicit re-review",color="#ee715e"]; Approve [label="Independent approver"]; Tx [label="One DB transaction\napproved master + outbox",fillcolor="#eaf253",fontcolor="#11130f"]; Draft -> Task -> Change; Change -> Reject [label="yes"]; Change -> Approve [label="no"]; Approve -> Tx; }
