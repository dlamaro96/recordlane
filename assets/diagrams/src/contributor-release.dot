digraph G { graph [label="Contributor and release flow",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; Fork [label="Fork / signed-off change"]; Fast [label="Lint · types · unit · contracts"]; Integration [label="PostgreSQL · browser · recovery"]; Evidence [label="Requirements + evidence gate"]; Build [label="Images · SDKs · chart · docs"]; Supply [label="SBOM · checksums · provenance"]; Release [label="0.x prerelease",fillcolor="#eaf253",fontcolor="#11130f"]; Fork -> Fast -> Integration -> Evidence -> Build -> Supply -> Release; }
