digraph G { graph [label="Logical components and state ownership",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9",fontname="Arial"]; edge [color="#eaf253"]; Web [label="React control plane"]; API [label="FastAPI modular monolith\nmastering · governance · auth"]; Worker [label="Durable workers\nfenced jobs · publication"]; DB [shape=cylinder,label="PostgreSQL\ncanonical state + RLS",fillcolor="#eaf253",fontcolor="#11130f"]; Plugins [label="Connector processes"]; Secrets [label="Secret adapters\nlocal encryption / Vault"]; Telemetry [label="OpenTelemetry + Prometheus\noptional Grafana profile"]; Assistant [label="Governed assistant\nlocal default · optional provider"]; Web -> API [label="JSON/HTTPS"]; API -> DB [dir=both,label="sync read/write"]; Worker -> DB [dir=both,label="async leases / outbox"]; Plugins -> API [label="contract envelopes"]; API -> Secrets [dir=both,label="references only"]; API -> Assistant [dir=both,label="filtered evidence / draft"]; API -> Telemetry [label="metrics + traces"]; Worker -> Telemetry [label="metrics + traces"]; }
