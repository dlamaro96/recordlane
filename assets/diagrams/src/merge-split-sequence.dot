digraph G { graph [label="Merge / split correction and repair",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; Preview [label="Preview contributions\nrelationships · consumers"]; Govern [label="Version-bound approval"]; Correct [label="Move evidence\npreserve old identity state"]; Event [label="Corrective event"]; Repair [label="Per-consumer repair queue",color="#f1b85b"]; Done [label="Reconciled\n(not merely locally split)"]; Preview -> Govern -> Correct -> Event -> Repair -> Done; }
