digraph G { graph [label="HA-oriented topology · external dependencies required",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; Ingress [label="HA ingress + TLS\nexternal"]; Pods [label="2+ API/web pods"]; Workers [label="2+ fenced workers"]; PG [shape=cylinder,label="HA PostgreSQL\nexternal"]; OIDC [label="HA identity provider\nexternal"]; Store [label="Versioned object storage\noptional external"]; Ingress -> Pods; Pods -> PG [dir=both]; Workers -> PG [dir=both]; Pods -> OIDC; Workers -> Store [dir=both,style=dashed]; }
