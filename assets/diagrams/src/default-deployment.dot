digraph G { graph [label="Default loopback demo deployment",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; Browser [label="Browser\n127.0.0.1:8088"]; Web [label="Nginx + React\nnon-root / read-only"]; API [label="API\nnon-root / read-only"]; DB [shape=cylinder,label="PostgreSQL 17.6"]; KC [label="Keycloak 26.7.3\ndemo only"]; Source [label="Paginated source"]; Sink [label="Idempotent signed sink"]; Browser -> Web; Web -> API; API -> DB; Browser -> KC [style=dashed]; Source -> API; API -> Sink [label="HMAC events"]; }
