digraph G { graph [label="Full-load to delta handoff",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; A [label="Open supported snapshot"]; B [label="Capture delta position"]; C [label="Stream full pages"]; D [label="Durably record batch"]; E [label="Advance checkpoint"]; F [label="Read deltas with overlap + tie-breaker"]; G [label="Reconcile completeness\n(no deletion on incomplete run)"]; A -> B -> C -> D -> E -> F -> G; }
