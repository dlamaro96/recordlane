digraph G { graph [label="Authentication, authorization, and secret trust boundaries",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR,compound=true]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; User [label="User browser"]; OIDC [label="OIDC issuer\nKeycloak or customer IdP"]; BFF [label="BFF/API\nsessions + field/action policy"]; DB [shape=cylinder,label="PostgreSQL\nworkspace RLS"]; Service [label="Scoped service identity\none-time credential"]; Connector [label="Isolated connector process"]; Secrets [label="Secret provider\nencrypted local or Vault"]; SCIM [label="SCIM administrator"]; User -> BFF [label="login / Secure session cookie"]; BFF -> OIDC [label="authorization code + PKCE",dir=both]; Service -> BFF [label="scoped credential"]; SCIM -> BFF [label="bearer + provisioning"]; BFF -> DB [label="workspace context",dir=both]; Connector -> BFF [label="capability envelopes"]; BFF -> Secrets [label="named reference",dir=both]; Secrets -> Connector [label="resolved only at use"]; }
