digraph G { graph [label="Authentication and trust boundaries",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR,compound=true]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; User [label="User browser"]; OIDC [label="OIDC issuer\nissuer + subject identity"]; BFF [label="BFF/API\ncentral authorization"]; DB [shape=cylinder,label="Workspace-scoped PostgreSQL"]; Service [label="Scoped service identity"]; Connector [label="Isolated connector process"]; User -> OIDC [label="code + PKCE"]; OIDC -> BFF [label="signed tokens"]; Service -> BFF [label="scoped credential"]; BFF -> DB; Connector -> BFF [label="capability contract"]; }
