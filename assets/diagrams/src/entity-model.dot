digraph G { graph [label="Entity and evidence model",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=record,style=filled,fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; W [label="Workspace|isolation boundary"]; S [label="Source|capabilities|checkpoint"]; R [label="SourceRecord|original|normalized|state|time"]; E [label="Entity|stable identity|version"]; M [label="MasterVersion|draft / approved|values|provenance"]; T [label="ReviewTask|bound version|workflow version"]; O [label="OutboxEvent|entity version|delivery state"]; W -> S; S -> R; R -> E; E -> M; M -> T; M -> O; }
