digraph G { graph [label="Source-to-master attribute lineage",labelloc=t,bgcolor="#11130f",fontcolor="#f1f3e9",pad=.4,rankdir=LR]; node [shape=box,style="rounded,filled",fillcolor="#20241d",color="#65705d",fontcolor="#f1f3e9"]; Raw [label="Original value\nscript preserved"]; Normal [label="Normalized comparison value"]; Evidence [label="Pair evidence\npolicy version"]; Identity [label="Stable identity"]; Survivor [label="Attribute choice\nsource + verification + time"]; Approved [label="Approved master version",fillcolor="#eaf253",fontcolor="#11130f"]; Raw -> Normal; Normal -> Evidence; Evidence -> Identity; Raw -> Survivor; Identity -> Survivor; Survivor -> Approved; }
